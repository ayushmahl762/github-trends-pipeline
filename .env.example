# ---------- GitHub ----------
# Personal access token (no scopes needed for public data). Required: unauthenticated limit is 60 req/hr.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_LANGUAGES=Python,JavaScript,TypeScript,Rust,Go,Java,C++,C#
REPOS_PER_LANGUAGE=25
MIN_STARS=1000
# Max pages (100 items each) fetched per repo per endpoint per run
MAX_PAGES_PER_ENDPOINT=5
REQUEST_TIMEOUT=30
MAX_RETRIES=5
# Longest single sleep (seconds) for a rate-limit reset before failing the task
MAX_RATE_LIMIT_WAIT=3900
# Minimum remaining core requests required by the API health check
MIN_RATE_LIMIT_REMAINING=300

# ---------- Warehouse (PostgreSQL 15) ----------
WAREHOUSE_HOST=warehouse-db
WAREHOUSE_PORT=5432
WAREHOUSE_DB=github_trends
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me_warehouse
# Host port for BI tools (Power BI connects to localhost:<this port>)
WAREHOUSE_HOST_PORT=5433

# ---------- Airflow ----------
AIRFLOW_UID=50000
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_DB_NAME=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_WEBSERVER_PORT=8080

# ---------- dbt ----------
DBT_TARGET=dev
DBT_THREADS=4
